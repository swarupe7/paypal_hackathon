# Sandbox REST app from https://developer.paypal.com/dashboard/applications/sandbox
# Use the Sandbox toggle. Do not put Live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Any OpenAI-compatible chat API. The worker and the verifier are separate calls.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

PORT=8787
